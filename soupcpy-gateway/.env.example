# Copy to .env and adjust; docker compose reads it automatically.
#
# Host port the gateway is published on.
GATEWAY_PORT=3000

# How a browser reaches the gateway. These only change the stream links the
# dashboard hands out (/api/settings), not what the container binds.
#
# Serving other machines on the LAN: set this to this host's address, because
# "localhost" in a generated link resolves to the viewer's own machine.
GATEWAY_PUBLIC_HOST=localhost
GATEWAY_PUBLIC_PORT=3000

# Set to https when something terminates TLS in front of the gateway. That also
# switches generated WebSocket URLs to wss://, which a browser requires on an
# https page.
GATEWAY_PUBLIC_SCHEME=http

RUST_LOG=info
